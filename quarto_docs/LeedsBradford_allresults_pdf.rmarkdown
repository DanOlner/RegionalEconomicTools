# unique(avsizes$SIC07_description)[!unique(avsizes$SIC07_description) %in% both.wide.pos$sector]
both.wide.pos.filter <- both.wide.pos %>% 
  filter(
    sector %in% avsizes$SIC07_description[avsizes$min_percent > 1]
  )


both.wide.pos.filter <- both.wide.pos.filter %>% 
  mutate(
    sector = case_when(
      grepl('petrol',sector,ignore.case = T) ~ 'petrol/chem',
      grepl('public',sector,ignore.case = T) ~ 'public admin/defence',
      grepl('electr',sector,ignore.case = T) ~ 'power/water',
      grepl('constru',sector,ignore.case = T) ~ 'buildings',
      grepl('special',sector,ignore.case = T) ~ 'spec construct',
      grepl('financ',sector,ignore.case = T) ~ 'finance/insu',
      grepl('legal',sector,ignore.case = T) ~ 'legal/accounting',
      grepl('employment',sector,ignore.case = T) ~ 'employment/security',
      grepl('information',sector,ignore.case = T) ~ 'ICT',
      grepl('transport',sector,ignore.case = T) ~ 'Transport',
      grepl('scientific',sector,ignore.case = T) ~ 'Scientific',
      grepl('real estate',sector,ignore.case = T) ~ 'Real est',
      grepl('entertainment',sector,ignore.case = T) ~ 'Entertainment',
      grepl('health',sector,ignore.case = T) ~ 'Health',
      grepl('food',sector,ignore.case = T) ~ 'Food/service',
      grepl('care',sector,ignore.case = T) ~ 'Res care',
      .default = sector
    )
  )
  


